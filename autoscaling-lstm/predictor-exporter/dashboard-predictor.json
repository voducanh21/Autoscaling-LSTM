{
  "title": "LSTM Autoscaling – Single Service (4 Panels)",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "service",
        "label": "Service",
        "query": "api-gateway,authentication-service,order-service,payment-service,product-service",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "RPS – Observed vs Predicted",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "svc:qps:rate1m{job=~\"$service\"}",
          "legendFormat": "observed_rps ({{job}})"
        },
        {
          "expr": "lstm_pred_rps{exported_service=~\"$service\"}",
          "legendFormat": "pred_rps ({{exported_service}})"
        }
      ]
    },
    {
      "title": "CPU – Observed vs Predicted",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pod:cpu:usage1m{namespace=\"apps\", pod=~\"($service)-.*\"} * 1000",
          "legendFormat": "observed_cpu ({{pod}})"
        },
        {
          "expr": "lstm_pred_cpu{exported_service=~\"$service\"}",
          "legendFormat": "pred_cpu ({{exported_service}})"
        }
      ]
    },
    {
      "title": "Memory – Observed vs Predicted",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pod:mem:usage{namespace=\"apps\", pod=~\"($service)-.*\"} / 1024 / 1024",
          "legendFormat": "observed_mem ({{pod}})"
        },
        {
          "expr": "lstm_pred_mem{exported_service=~\"$service\"}",
          "legendFormat": "pred_mem ({{exported_service}})"
        }
      ]
    },
    {
      "title": "Desired Replicas (Autoscaling Signal)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "lstm_desired_replicas{exported_service=~\"$service\"}",
          "legendFormat": "desired_replicas ({{exported_service}})"
        }
      ]
    }
  ]
}
