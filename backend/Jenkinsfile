pipeline {
    agent any
    environment {
        DOCKERHUB_TOKEN = credentials('dckr_pat_kPqktvIeWLBlIokXyQyNCTkIdcM')
        GITHUB_TOKEN = credentials('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')
        SONAR_TOKEN = credentials('71bfed0ad55a78ade757df01a2b475661a11b18c')
        REPO = 'https://github.com/lvpdung/E-commerce_Web.git'
        IMAGE_NAME = 'ecommerce-web'
        SONARQUBE_ENV = 'SonarQubeServer' 
    }
    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/main']], userRemoteConfigs: [[url: env.REPO]]])
            }
        }
        stage('Trivy FS Scan & Export for SonarQube') {
            steps {
                sh 'trivy fs --format json --output trivy-report.json .'
                archiveArtifacts artifacts: 'trivy-report.json', fingerprint: true
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(env.SONARQUBE_ENV) {
                    sh 'mvn clean verify sonar:sonar -Dsonar.externalIssuesReportPaths=trivy-report.json'
                }
            }
        }
        stage('Build & Push Docker Image') {
            steps {
                script {
                    def tag = "${env.IMAGE_NAME}:${env.BUILD_ID}-${new Date().format('yyyyMMddHHmmss')}"
                    sh """
                        echo "${env.DOCKERHUB_TOKEN_PSW}" | docker login -u "${env.DOCKERHUB_TOKEN_USR}" --password-stdin
                        docker build -t ${tag} .
                        docker push ${tag}
                        docker logout
                    """
                    env.IMAGE_TAG = tag
                }
            }
        }
        stage('Trivy Image Scan') {
            steps {
                sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${env.DOCKERHUB_USER}/${env.IMAGE_TAG}"
            }
        }
        stage('Update K8s Manifest & GitOps Commit') {
            steps {
                script {
                    sh "sed -i 's|image: .*|image: ${env.DOCKERHUB_USER}/${env.IMAGE_TAG}|' k8s/deployment.yaml"
                    sh "yamllint k8s/deployment.yaml"
                    sh "git config user.email 'ci@yourdomain.com'"
                    sh "git config user.name 'CI Bot'"
                    sh """
                        git add k8s/deployment.yaml
                        git commit -m 'Update image tag to ${env.IMAGE_TAG}'
                        git push https://x-access-token:${env.GITHUB_TOKEN}@github.com/lvpdung/E-commerce_Web.git HEAD:phuongdung
                    """
                }
            }
        }
    }
    post {
        success {
            mail to: 'dev-team@yourdomain.com', subject: "Jenkins Build Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}", body: "Build succeeded!"
        }
        failure {
            mail to: 'dev-team@yourdomain.com', subject: "Jenkins Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}", body: "Build failed! Check Jenkins for details."
        }
    }
}
